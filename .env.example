# ============================================================================
# Единый конфиг для всей системы. Читается и Electron-оверлеем
# (overlay/main.js), и voice-сервисом (python-services/voice/server.py).
# ============================================================================

# --- LLM (KoboldCPP) ---
KOBOLD_URL=http://localhost:5001
LLM_TEMPERATURE=0.8
# Ограничивает МАКСИМАЛЬНУЮ длину ответа - сама по себе не гарантирует
# краткость (это дело промпта), но подстраховывает от случайных "простыней"
# текста, которые потом дольше и озвучивать, и ждать генерацию.
LLM_MAX_TOKENS=150

# --- Voice-сервис (TTS + RVC + STT, один процесс) ---
VOICE_URL=http://localhost:5100
VOICE_PORT=5100

# Автозапускать server/server.py прямо из client (main.js) при старте
# приложения. Выключи (false), если хочешь запускать сервис вручную сам
# (например, при отладке) - тогда main.js просто дождётся, что он уже
# отвечает на VOICE_URL, и не будет им управлять.
AUTO_START_VOICE_SERVER=true

# TTS (Silero) (kseniya, xenia, baya, aidar, eugene)
TTS_SPEAKER=kseniya
# Можно временно отключить озвучку (true/false), не трогая остальной пайплайн
VOICE_ENABLED=true

# RVC (опционально) - оставь RVC_MODEL_PATH пустым, если кастомный голос
# пока не нужен. RVC_ENABLED тут дополнительно отключает вызов на стороне
# Node, даже если модель в принципе настроена ниже.
RVC_ENABLED=false
RVC_MODEL_PATH=../models/rvc/model/model.pth
RVC_INDEX_PATH=../models/rvc/model/model.index
RVC_DEVICE=cuda:0
RVC_VERSION=v2
RVC_PITCH=0
RVC_F0_METHOD=rmvpe
RVC_INDEX_RATE=0.75

# STT (Whisper)
# small - хороший баланс при параллельной работе с LLM на 16 ГБ ОЗУ.
# medium точнее, но добавляет памяти этому сервису.
STT_MODEL_SIZE=small
STT_DEVICE=cuda
STT_BEAM_SIZE=
