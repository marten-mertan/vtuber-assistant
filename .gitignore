# ============================================================================
# Конфиг с секретами/путями — у каждого свой, в репозиторий не идёт.
# Шаблон — .env.example — остаётся закоммиченным.
# ============================================================================
.env

# ============================================================================
# Node / Electron (client/)
# ============================================================================
node_modules/
client/node_modules/

# Артефакты сборки electron-builder (npm run dist)
dist/
client/dist/

# npm/yarn логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================================
# Python (server/)
# ============================================================================
venv/
server/venv/
__pycache__/
*.pyc
*.pyo

# ============================================================================
# Веса моделей — все скачиваются/обучаются отдельно, тяжёлые (сотни МБ —
# несколько ГБ), в git не идут. См. README.md, раздел "Установка".
# ============================================================================

# Silero TTS — скачивается автоматически при первом запуске server/server.py
models/tts/*
!models/tts/.gitkeep

# RVC — веса своих/скачанных голосовых моделей (.pt, .pth, .index)
server/rmvpe.pt
server/hubert_base.pt
models/rvc/*
!models/rvc/.gitkeep

# Live2D-модели — лицензированный контент, распространять через git нельзя. В репозитории есть только пример эмоций.
models/live2d/*
!models/live2d/emotions.example.json

# Cubism Core — проприетарный рантайм Live2D, качается отдельно с
# официального сайта по их лицензии.
live2d-core/*
!live2d-core/.gitkeep

# ============================================================================
# Разное
# ============================================================================

# Результат диагностического скрипта test-voices.js
test-output/

# Логи/крэш-дампы KoboldCPP, если запускается из этой же папки
*.log

# ОС-специфичный мусор
Thumbs.db
.DS_Store

# Редакторы/IDE
.vscode/
.idea/
